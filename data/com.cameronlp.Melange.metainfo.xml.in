<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.cameronlp.Melange</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Melange</name>
  <summary>Visualize your music with MilkDrop</summary>
  <description>
    <p>
      Melange turns whatever your computer is playing into MilkDrop visuals.
      It renders natively with projectM, listens to system audio or a
      microphone, and comes with projectM's curated “Cream of the Crop”
      collection of about 9,800 presets.
    </p>
    <ul>
      <li>Browse presets by category or search, keep favorites, a queue and playlists</li>
      <li>Open your own .milk presets, which are remembered between launches</li>
      <li>Change presets on a timer, on beats or when the song changes</li>
      <li>A sidebar for presets and preferences, so you see every change as you make it</li>
      <li>Fullscreen, Hide Controls and Transparency Mode</li>
      <li>A Now Playing overlay for whatever music player is running</li>
      <li>Mirror windows for a second screen</li>
      <li>Eleven mini visualizers: meters, scopes, spectrums, 3D views and more</li>
    </ul>
  </description>

  <developer id="com.cameronlp">
    <name>Cameron</name>
  </developer>

  <url type="homepage">https://github.com/CameronLP/Melange</url>
  <url type="vcs-browser">https://github.com/CameronLP/Melange</url>
  <url type="bugtracker">https://github.com/CameronLP/Melange/issues</url>

  <translation type="gettext">melange</translation>
  <launchable type="desktop-id">com.cameronlp.Melange.desktop</launchable>
  <content_rating type="oars-1.1" />

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <!-- From the app icon's amber. -->
  <branding>
    <color type="primary" scheme_preference="light">#f0d27a</color>
    <color type="primary" scheme_preference="dark">#7a5a0a</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/CameronLP/Melange/main/docs/screenshots/main.png</image>
      <caption>A MilkDrop preset playing</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CameronLP/Melange/main/docs/screenshots/presets.png</image>
      <caption>Browsing presets in the sidebar</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CameronLP/Melange/main/docs/screenshots/preferences.png</image>
      <caption>Preferences beside the visualizer</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CameronLP/Melange/main/docs/screenshots/mini-visualizers.png</image>
      <caption>Mini visualizers</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-11-25">
      <description translate="no">
        <p>First version: native MilkDrop rendering with projectM, the Cream of the Crop presets, Now Playing, mirror windows and mini visualizers.</p>
      </description>
    </release>
  </releases>

</component>
