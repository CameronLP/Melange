<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="MelangeWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Melange</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <property name="content">
      <object class="AdwToolbarView" id="toolbar_view">
        <child type="top">
          <object class="AdwHeaderBar" id="headerbar">
            <property name="show-title">true</property>

            <!-- Load Preset File dropped from the header bar for now -
                 MilkDrop conversion isn't reliable enough yet to give
                 it top-level prominence. Still reachable from the
                 hamburger menu (win.load-preset). -->

            <child type="end">
              <object class="GtkButton" id="fullscreen_button">
                <property name="icon-name">view-fullscreen-symbolic</property>
                <property name="tooltip-text" translatable="yes">Toggle Fullscreen</property>
                <property name="action-name">win.toggle-fullscreen</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>

            <!-- Shows/hides the presets and settings sidebar (window.py
                 build_sidebar binds it to the split view). -->
            <child type="end">
              <object class="GtkToggleButton" id="sidebar_button">
                <property name="icon-name">sidebar-show-right-symbolic</property>
                <property name="tooltip-text" translatable="yes">Presets and Preferences</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="GtkBox" id="content_box">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>

  <menu id="primary_menu">

    <section>

      <!-- The actual segmented button row is built and attached in
           window.py (build_theme_selector), same as the other custom
           widgets below. -->
      <item>
        <attribute name="custom">theme-selector</attribute>
      </item>

    </section>

    <section>

      <item>
        <attribute name="label" translatable="yes">Lock Preset</attribute>
        <attribute name="action">win.lock-preset</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">Shuffle Presets</attribute>
        <attribute name="action">win.shuffle-preset</attribute>
      </item>

    </section>

    <!-- The quick on/off modes. Presets, settings, the audio source,
         mirror windows and the mini visualizers live in the sidebar
         (window.py build_sidebar). -->
    <section>

      <!-- Checkable, not an action-only item - reflects
           self.immersive_mode_enabled so it reads correctly if somehow
           toggled from elsewhere. The only way *out* once it's on is
           the right-click context menu on the content area
           (on_content_right_click) - the header bar (and this menu
           with it) disappears the moment this turns on, by design. -->
      <item>
        <attribute name="label" translatable="yes">Immersive Mode</attribute>
        <attribute name="action">win.immersive-mode</attribute>
      </item>

      <!-- Back in the hamburger menu on request, after previously
           being made settings-only ("should only be in settings") -
           Preferences > Appearance > Transparency Mode still exists
           for the Opacity Level/Fade Speed sliders, this is just a
           quick on/off toggle alongside the other window-appearance
           items in this section. Checkable the same way Immersive
           Mode above is (a plain item pointing at a stateful boolean
           action). -->
      <item>
        <attribute name="label" translatable="yes">Transparency Mode</attribute>
        <attribute name="action">win.transparency-mode</attribute>
      </item>

      <!-- Same shape as Transparency Mode/Immersive Mode above -
           requested in addition to (not instead of) the Preferences >
           Appearance > Now Playing > Enabled switch, which stays in
           sync with this automatically via the shared action. -->
      <item>
        <attribute name="label" translatable="yes">Now Playing</attribute>
        <attribute name="action">win.now-playing-enabled</attribute>
      </item>

    </section>

    <section>

      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">_About Melange</attribute>
        <attribute name="action">app.about</attribute>
      </item>

    </section>

  </menu>
</interface>
