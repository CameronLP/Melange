<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="MelangeWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Melange</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <property name="content">
      <object class="AdwToolbarView" id="toolbar_view">
        <child type="top">
          <object class="AdwHeaderBar" id="headerbar">
            <property name="show-title">true</property>



            <!-- Load Preset File dropped from the header bar for now -
                 MilkDrop conversion isn't reliable enough yet to give
                 it top-level prominence. Still reachable from the
                 hamburger menu (win.load-preset). -->

            <child type="start">
              <object class="GtkButton" id="browse_presets_button">
                <property name="icon-name">system-search-symbolic</property>
                <property name="tooltip-text" translatable="yes">Presets</property>
                <property name="action-name">win.browse-presets</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkButton" id="fullscreen_button">
                <property name="icon-name">view-fullscreen-symbolic</property>
                <property name="tooltip-text" translatable="yes">Toggle Fullscreen</property>
                <property name="action-name">win.toggle-fullscreen</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="GtkBox" id="content_box">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>

  <menu id="primary_menu">

    <section>

      <!-- The actual segmented button row is built and attached in
           window.py (build_theme_selector), same as the other custom
           widgets below. -->
      <item>
        <attribute name="custom">theme-selector</attribute>
      </item>

    </section>


    <section>

      <!-- Populated at runtime in window.py (rebuild_audio_source_menu)
           with the currently connected output devices, since that list
           changes as devices are plugged/unplugged. -->
      <submenu id="audio_source_submenu">
        <attribute name="label">Audio Source</attribute>
      </submenu>

    </section>


    <section>

      <!-- Used to be a submenu (Browse Presets…/Favorites…/Queue…/
           Playlists…) plus a separate top-level Load Preset… item -
           collapsed to one entry on request ("I do not want presets
           submenu. Just open the presets window, and stuff is divided
           by tabs. simpler"). Everything those used to jump straight
           to a specific starting tab for is now just a tab inside the
           one dialog (Presets/Favorites/Queue/Loaded - see
           build_preset_browser_dialog), and Load Preset… moved to a
           button inside the Presets tab itself (build_presets_tab).
           win.show-favorites/-queue/-playlists still exist as actions
           (the Queue tab's own Playlists… button still uses
           win.show-playlists) - only their menu entries are gone. -->
      <item>
        <attribute name="label" translatable="yes">_Presets…</attribute>
        <attribute name="action">win.browse-presets</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">Lock Preset</attribute>
        <attribute name="action">win.lock-preset</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">Shuffle Presets</attribute>
        <attribute name="action">win.shuffle-preset</attribute>
      </item>

    </section>


    <!-- Split from the preset-behavior section above (Presets…/Lock
         Preset/Shuffle Presets) - conceptually a different kind of
         thing (opening/managing secondary windows, not preset
         behavior), which read as one flat undifferentiated block
         without this. -->
    <section>

      <submenu id="mirror_windows_submenu">
        <attribute name="label" translatable="yes">Mirror Windows</attribute>

        <section>

          <item>
            <attribute name="label" translatable="yes">_New Mirror Window…</attribute>
            <attribute name="action">win.new-mirror-window</attribute>
          </item>

          <item>
            <attribute name="label" translatable="yes">Close All Mirrors</attribute>
            <attribute name="action">win.close-all-mirrors</attribute>
          </item>

        </section>

        <!-- Populated at runtime in window.py (rebuild_mirror_windows_menu)
             with the currently open mirror windows, since that list
             changes as mirrors are opened/closed. Its own section
             (rather than folded into the one above) so rebuilding it
             doesn't have to touch the static New/Close items. -->
        <section id="open_mirrors_section">
        </section>

      </submenu>

      <!-- Experimental (see TODO.md) - each a plain checkable toggle
           (win.show-vu-meter/win.show-xy-scope) rather than a
           New Window action, since only one of each makes sense open
           at a time. -->
      <submenu id="aux_windows_submenu">
        <attribute name="label" translatable="yes">Mini Visualizers</attribute>

        <item>
          <attribute name="label" translatable="yes">VU Meter</attribute>
          <attribute name="action">win.show-vu-meter</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">Peak Meter</attribute>
          <attribute name="action">win.show-peak-meter</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">X-Y Scope</attribute>
          <attribute name="action">win.show-xy-scope</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">Oscilloscope</attribute>
          <attribute name="action">win.show-oscilloscope</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">Vector Scope</attribute>
          <attribute name="action">win.show-vectorscope</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">Spectrum</attribute>
          <attribute name="action">win.show-spectrum</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">Spectrogram</attribute>
          <attribute name="action">win.show-spectrogram</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">3D Terrain Spectrogram</attribute>
          <attribute name="action">win.show-terrain</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">3D Waterfall</attribute>
          <attribute name="action">win.show-waterfall</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">DVD Bounce</attribute>
          <attribute name="action">win.show-dvd-bounce</attribute>
        </item>

        <item>
          <attribute name="label" translatable="yes">Pipes</attribute>
          <attribute name="action">win.show-pipes</attribute>
        </item>

      </submenu>

    </section>


    <section>

      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>

      <item>
        <attribute name="label" translatable="yes">_About Melange</attribute>
        <attribute name="action">app.about</attribute>
      </item>

    </section>

  </menu>
</interface>
