{
    "app-id" : "com.cameronlp.Melange",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "command" : "melange",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-run/gvfs",
        "--filesystem=xdg-run/pipewire-0",
        "--filesystem=home:ro",
        "--talk-name=org.freedesktop.portal.Desktop",
	"--talk-name=org.freedesktop.portal.PermissionStore",
	"--talk-name=org.mpris.MediaPlayer2.*",
	"--device=all"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "melange",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
