@@ -54,6 +54,16 @@ Texture::~Texture()
 
 void Texture::Bind(GLint slot, const Sampler::Ptr& sampler) const
 {
+    // A default-constructed Texture (id 0, target GL_NONE) is used as
+    // a placeholder, e.g. for an attachment slot or a preset that has
+    // never actually been rendered yet. Binding GL_NONE is invalid
+    // and raises GL_INVALID_ENUM, so just skip - there's no real
+    // texture to bind anyway.
+    if (m_textureId == 0)
+    {
+        return;
+    }
+
     glActiveTexture(GL_TEXTURE0 + slot);
     glBindTexture(m_target, m_textureId);
 
